# ---------------------------------------------------------------------------
# YogAI — Frontend environment variables (Vite). Only VITE_* vars are exposed
# to the browser, and they MUST NOT contain secrets.
# ---------------------------------------------------------------------------
# Leave empty to use the Vite dev proxy (/api -> http://localhost:5000).
# In production set this to your deployed API origin, e.g.
# VITE_API_BASE_URL=https://yogai-api.onrender.com
VITE_API_BASE_URL=
