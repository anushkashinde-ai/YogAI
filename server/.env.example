# ---------------------------------------------------------------------------
# YogAI — Backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit the real .env
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
# Public URL of this API (used in reset-password links + CORS allow-list)
API_BASE_URL=http://localhost:5000

# MongoDB (MongoDB Atlas or local)
# Atlas example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/yogai
MONGODB_URI=mongodb://127.0.0.1:27017/yogai

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Cookies (set COOKIE_SECURE=true in production / behind HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# CORS — comma separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# AI provider (OPTIONAL). Leave AI_API_KEY empty to run the chatbot in
# clearly-labelled DEMO MODE using predefined yoga responses.
# Works with any OpenAI-compatible chat-completions endpoint.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# Seed data (used by `npm run seed`)
SEED_ADMIN_NAME=YogAI Admin
SEED_ADMIN_EMAIL=admin@yogai.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_EMAIL=demo@yogai.app
SEED_DEMO_PASSWORD=Demo@12345
